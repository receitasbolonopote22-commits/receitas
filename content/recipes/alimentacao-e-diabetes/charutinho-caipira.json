      "items": [
        "6 folhas de couve-manteiga"
      ]
    },
    {
      "title": "Molho",
      "items": [
        "1 e 1/2 xícara chá de caldo de legumes \"0% de gordura\"",
        "1/2 xícara (chá) de purê de tomate",
        "Salsinha picada (opcional)"
      ]
    },
    {
      "title": "Recheio",
      "items": [
        "200 g de carne moída magra",
        "1/2 cebola ralada",
        "1/2 lata de milho verde",
        "1 colher (sopa) de salsa picada",
        "Colher (chá) de sal"
      ]
    }
  ],
  "instructions": [
    {
      "title": null,
      "steps": [
        "Corte cada folha de couve ao meio e escalde-as em água fervente.",
        "Reserve."
      ]
    },
    {
      "title": "Recheio",
      "steps": [
        "Misture todos os ingredientes. Coloque um pouco de recheio sobre cada metade das folhas de couve e enrole-as como um charuto."
      ]
    },
    {
      "title": "Molho",
      "steps": [
        "Misture os ingredientes.",
        "Em uma panela, acomode os charutinhos, um ao lado do outro, e regue com o molho.",
        "Tampe a panela e leve ao fogo baixo por cerca de 30 minutos.",
        "Salpique a salsinha e sirva."
      ]
    }
  ],
