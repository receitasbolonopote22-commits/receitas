      "items": [
        "150 g de macarrão integral",
        "2 ovos",
        "1 cebola picada",
        "1 dente de alho picado",
        "3 tomates pequenos picados",
        "1 xícara de chá de ervilha",
        "1 ramo de brócolis",
        "Folhas de espinafre fresco",
        "Folhas de manjericão",
        "Azeite",
        "Um pouco de vinho branco",
        "Sal e pimenta-do-reino a gosto"
      ]
    }
  ],
  "instructions": [
    {
      "title": null,
      "steps": [
        "Cozinhe os ovos.",
        "Em outra panela, refogue a cebola e o alho com azeite.",
        "Junte os tomates, um pouco de vinho branco e água.",
        "Quando ferver, adicione o macarrão.",
        "Após 10 minutos, acrescente as ervilhas, o brócolis e o manjericão.",
        "Tempere com sal e pimenta.",
        "Quando estiver tudo cozido, espere esfriar e sirva com os ovos cortados ao meio e folhas de espinafre; finalize com azeite se desejar."
      ]
    }
  ],
