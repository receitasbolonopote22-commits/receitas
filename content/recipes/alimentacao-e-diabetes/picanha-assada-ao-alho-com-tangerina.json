      "items": [
        "1 picanha de aproximadamente 1kg sem gordura",
        "1 colher (sopa) de sal",
        "6 dentes de alho amassados",
        "Sal e pimenta do reino a gosto",
        "2 xícaras (chá) de suco de tangerina"
      ]
    }
  ],
  "instructions": [
    {
      "title": null,
      "steps": [
        "Tempere a picanha com sal, alho, e pimenta.",
        "Leve ao forno preaquecido a 220° C por 1 hora e 30 minutos.",
        "Despeje o suco de tangerina aos poucos sobre a picanha e asse por mais 15 minutos.",
        "Vire a picanha e regue com mais suco até que fique dourada.",
        "Sirva bem quente."
      ]
    }
