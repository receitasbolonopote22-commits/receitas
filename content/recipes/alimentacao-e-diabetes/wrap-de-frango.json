  "ingredients": [
    {
      "title": null,
      "items": [
        "2 wraps integrais",
        "300g de peito de frango cozido e desfiado",
        "150g de cream cheese light",
        "2 xícaras (chá) de rúcula picada",
        "1 xícara (chá) de tomate seco",
        "1 colheres (sopa) de azeite de oliva",
        "Suco de ½ limão",
        "Sal e pimenta-do-reino a gosto"
      ]
    }
  ],
  "instructions": [
    {
      "title": null,
      "steps": [
        "Comece temperando o frango com o sal e a pimenta-do-reino e refogue em uma frigideira aquecida com azeite de oliva por cerca de 5 minutos.",
        "Reserve.",
        "Em um recipiente, misture o cream cheese com o suco de limão e tempere com sal e pimenta-do-reino a gosto.",
        "Abra a massa de Wrap e espalhe a mistura de cream cheese sobre ele.",
        "Adicione a rúcula, o tomate seco e o peito de frango desfiado e enrole a massa como se fosse uma \"panqueca\".",
        "Faça o mesmo no restante das massas e sirva em seguida."
      ]
    }
  ],
