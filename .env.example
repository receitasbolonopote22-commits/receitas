# Copie para .env.local (no computador) e configure também na hospedagem.
# Senha única de acesso de todas as clientes. Maiúsculas/minúsculas e espaços nas pontas são ignorados.
# Trocar esta senha desconecta todo mundo, que precisa entrar de novo com a nova.
SITE_PASSWORD=troque-esta-senha

# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br
